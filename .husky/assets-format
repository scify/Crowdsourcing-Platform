# .husky/assets-format

# Get a list of the staged files that Prettier formats
FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(js|mjs|vue|scss|css)$' || true)

# Run Prettier on the staged files only (.prettierignore still applies)
if [ -n "$FILES" ]; then
    echo "Running Prettier for staged files..."
    echo "$FILES" | xargs .husky/run-tool npx prettier --write --ignore-unknown
    if [ $? -ne 0 ]; then
        echo "Prettier failed."
        exit 1
    fi

    # Restage the formatted files
    echo "$FILES" | xargs -r git add
fi

exit 0
