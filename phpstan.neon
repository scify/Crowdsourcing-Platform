includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - database
        - routes

    ignoreErrors:
        # Composite-key models (CompositeKeysModel pattern) assign an array to
        # Eloquent's string-typed $primaryKey. Modelling this correctly needs a
        # PHPStan stub or a rework of the pattern, not annotations. Deliberate.
        -
            identifier: property.defaultValue
            message: '#\$primaryKey \(string\) does not accept default value of type array#'

        # Seeder fixture arrays: PHPStan proves isset('translations') is always
        # true on the literal data. The guard stays for safety when fixtures
        # change. Deliberate.
        -
            identifier: isset.offset
            paths:
                - database/seeders/ProblemSeeder.php
                - database/seeders/SolutionSeeder.php
