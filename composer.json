{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3.0",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "awobaz/compoships": "^3.0",
        "drewm/mailchimp-api": "^2.5.4",
        "google/cloud-translate": "^1.21",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.8.2",
        "laravel/socialite": "^5.29.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.1",
        "league/flysystem-aws-s3-v3": "^3.35",
        "nunomaduro/collision": "^8.9.5",
        "phpoffice/phpspreadsheet": "^5.9",
        "predis/predis": "^3.0",
        "scify/laravel-cookie-guard": "^4.1",
        "sentry/sentry": "^4.30.0",
        "sentry/sentry-laravel": "^4.27.0",
        "socialiteproviders/twitter": "^4.1.2",
        "spatie/laravel-newsletter": "^5.3.1",
        "spatie/laravel-sitemap": "^8.0",
        "staudenmeir/belongs-to-through": "^2.18"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "fakerphp/faker": "^1.24.1",
        "filp/whoops": "^2.18.4",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Helpers\\": "database/helpers/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Utils/UrlHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Helpers\\": "database/helpers/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "lint": [
            "npm run lint",
            "vendor/bin/pint --parallel --test"
        ],
        "format": [
            "npm run format",
            "vendor/bin/pint --parallel"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --no-progress"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.29"
        }
    }
}
