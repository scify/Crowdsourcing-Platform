{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3.0",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "awobaz/compoships": "^3.0",
        "drewm/mailchimp-api": "^2.5.4",
        "google/cloud-translate": "^1.21",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.36.0",
        "laravel/helpers": "^1.8.2",
        "laravel/socialite": "^5.29.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.1",
        "league/flysystem-aws-s3-v3": "^3.35",
        "nunomaduro/collision": "^8.9.5",
        "phpoffice/phpspreadsheet": "^5.9",
        "predis/predis": "^3.0",
        "scify/laravel-cookie-guard": "^5.1.0",
        "sentry/sentry": "^4.30.0",
        "sentry/sentry-laravel": "^4.27.0",
        "socialiteproviders/twitter": "^4.1.2",
        "spatie/laravel-newsletter": "^5.3.1",
        "spatie/laravel-sitemap": "^8.0",
        "staudenmeir/belongs-to-through": "^2.18"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "fakerphp/faker": "^1.24.1",
        "filp/whoops": "^2.18.4",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Helpers\\": "database/helpers/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Utils/UrlHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Helpers\\": "database/helpers/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=cookies-consent-public --force"
        ],
        "setup": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@composer install",
            "@php -r \"require 'vendor/autoload.php'; empty(Dotenv\\Dotenv::parse(file_get_contents('.env'))['APP_KEY'] ?? null) && exit(pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan key:generate --ansi', 'w')));\"",
            "@php -r \"file_exists('node_modules/.package-lock.json') && filemtime('node_modules/.package-lock.json') >= filemtime('package-lock.json') || exit(pclose(popen('npm ci', 'w')));\"",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -r \"touch('storage/database_testing.sqlite');\" @no_additional_args",
            "@php artisan migrate:fresh --seed --env=testing --database=sqlite_testing --ansi @no_additional_args",
            "@php artisan test --env=testing"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -r \"touch('storage/database_testing.sqlite');\" @no_additional_args",
            "@php artisan migrate:fresh --seed --env=testing --database=sqlite_testing --ansi @no_additional_args",
            "@php artisan test --env=testing --coverage --min=48"
        ],
        "analyse": "phpstan analyse --no-progress",
        "lint:check": [
            "pint --parallel --test",
            "rector --dry-run --no-progress-bar",
            "@analyse",
            "npm run check"
        ],
        "lint:fix": [
            "pint --parallel",
            "npm run lint:fix",
            "npm run format",
            "@analyse"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.29"
        }
    },
    "scripts-descriptions": {
        "setup": "Create .env if missing, install PHP dependencies and (when package-lock.json changed) npm dependencies, generate APP_KEY if empty and build the frontend.",
        "test": "Rebuild and seed the SQLite test database, then run the test suite. Extra arguments go to `artisan test`, e.g. `composer test -- --filter=Name`.",
        "test:coverage": "Run the test suite with coverage and the CI minimum of 48% (needs Xdebug or PCOV; in DDEV run `ddev xdebug on` first).",
        "analyse": "Run static analysis (Larastan).",
        "lint:check": "Check PHP style (Pint) and refactoring rules (Rector dry run), run static analysis (Larastan), lint JavaScript (ESLint) and check formatting (Prettier) without changing files. Same checks as CI.",
        "lint:fix": "Fix PHP style (Pint), JavaScript (ESLint --fix) and asset formatting (Prettier), then report what Larastan still finds."
    }
}
